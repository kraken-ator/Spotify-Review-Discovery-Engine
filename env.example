# Spotify Discovery Review Intelligence Engine — environment variables
# Copy this file to .env and fill in the values you have. Every variable
# here is optional in the sense that the app degrades gracefully without
# it (falls back to demo mode, or skips that one source) — but you need
# GROQ_API_KEY for genuine LLM synthesis instead of demo-mode placeholder
# content.

# ── Required for genuine synthesis ──
# Get a free key at https://console.groq.com
# Without this, the app and run_pipeline.py both fall back to demo-mode
# content (DEMO_FAILURE_MODES) — clearly flagged in the UI and CLI output,
# never silently merged with real review counts.
GROQ_API_KEY=gsk_your_api_key_here

# ── Optional: live Twitter API ──
# Only needed if you enable the "Twitter/X — Live API" toggle in the
# sidebar, or pass --twitter-live to run_pipeline.py. Note: Twitter's
# free developer tier returns 402 (paywalled) for search endpoints, so
# this will likely fail even with a token set — the Apify JSON export
# route (no token needed) is the reliable path for Twitter data.
TWITTER_BEARER_TOKEN=

# ── Optional: Apify export file paths ──
# Only used if you've exported Reddit/Twitter data from Apify and want
# a path other than the defaults below. Both also have UI text inputs
# in the sidebar (under "Data Sources") and CLI flags, which take
# precedence over these — set them here only if you want a persistent
# default across runs.
APIFY_REDDIT_FILE=data/apify_reddit.json
APIFY_TWITTER_FILE=data/apify_twitter.json
